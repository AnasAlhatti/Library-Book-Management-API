{
  "info": {
    "name": "Library Book Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Creates a book, tests CRUD and validation, then deletes the test book."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List books",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"The Hobbit\",\n  \"author\": \"J. R. R. Tolkien\",\n  \"genre\": \"Fantasy\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const book = pm.response.json();",
              "pm.collectionVariables.set('bookId', book.id);",
              "pm.test('Created book and default availability', () => { pm.expect(book).to.include({title:'The Hobbit', author:'J. R. R. Tolkien', genre:'Fantasy', available:true}); pm.expect(book.id).to.be.a('number'); pm.expect(Number.isSafeInteger(book.id)).to.eql(true); pm.expect(book.id).to.be.above(0); pm.expect(pm.response.headers.get('Location')).to.eql('/books/' + book.id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get created book",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct book', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('bookId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update availability",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books/{{bookId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"available\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Updated availability, preserved title', () => pm.expect(pm.response.json()).to.include({available:false, title:'The Hobbit'}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update title and trim whitespace",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books/{{bookId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"  The Hobbit (Revised)  \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Partial update preserves false', () => pm.expect(pm.response.json()).to.include({title:'The Hobbit (Revised)', available:false}));"
            ]
          }
        }
      ]
    },
    {
      "name": "List contains created book",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Created book is listed', () => pm.expect(pm.response.json().some(book => book.id === Number(pm.collectionVariables.get('bookId')))).to.eql(true));"
            ]
          }
        }
      ]
    },
